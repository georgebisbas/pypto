#include <pto/pto-inst.hpp>

#include "platform_comm/comm_context.h"
#include "pto/comm/comm_types.hpp"
#include "pto/comm/pto_comm_inst.hpp"
#include "tensor.h"

// Keep this after the qualifier fallbacks so hardware builds retain the
// [aicore] entry annotation while using simpler's logical SPMD context.
#include "intrinsic.h"

namespace {

static constexpr int64_t kTileCount = 256;
static constexpr int kMaxSupportedRanks = 16;

template <typename T>
AICORE inline __gm__ T *CommRemotePtr(__gm__ CommContext *ctx, __gm__ T *local_ptr, int pe) {
  uint64_t local_base = ctx->windowsIn[ctx->rankId];
  uint64_t offset = reinterpret_cast<uint64_t>(local_ptr) - local_base;
  return reinterpret_cast<__gm__ T *>(ctx->windowsIn[pe] + offset);
}

// Makes preceding GM/window stores visible before a peer Wait/load.
AICORE inline void PublishFence() {
  pipe_barrier(PIPE_ALL);
  dsb(DSB_DDR);
}

// N-way barrier on a private per-block signal lane at
// `peer * signal_stride + block_idx` (row stride `signal_stride`; RFC #2521
// K2 block-aware addressing, mirroring `builtin.tensor.allreduce`'s own
// per-block-lane clamp): AtomicAdd(+1) to each peer's cell → Wait(GE 1) on
// each peer's cell → AtomicAdd(-1) to clear. Used twice per call on the same
// lane (entry + exit). Reusing the same lane is safe: a rank cannot start
// occurrence K+1 until its own K has wait+cleared, and cannot finish K until
// peers have entered K, so notifies cannot cross occurrences. (Ring allreduce
// needs a distinct column per round because it only syncs adjacent ranks.) A
// block whose `block_idx` is not < `active_blocks` never calls this — see
// kernel_entry's early return — so `block_idx` here is always in range.
// Counts do not ride this signal at all (see Phase 2 below) — signal is
// barrier-only, so the full `signal_stride` is available for block lanes,
// no column is reserved.
AICORE inline void ExchangeBarrier(__gm__ CommContext *comm_ctx, __gm__ int32_t *signal_base, int my_rank,
                                    int nranks, int64_t signal_stride, int32_t block_idx) {
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    __gm__ int32_t *remote_signal =
        CommRemotePtr(comm_ctx, signal_base + my_rank * signal_stride + block_idx, peer);
    pto::comm::Signal sig(remote_signal);
    pto::comm::TNOTIFY(sig, static_cast<int32_t>(1), pto::comm::NotifyOp::AtomicAdd);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal sig(signal_base + peer * signal_stride + block_idx);
    pto::comm::TWAIT(sig, static_cast<int32_t>(1), pto::comm::WaitCmp::GE);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal self_sig(signal_base + peer * signal_stride + block_idx);
    pto::comm::TNOTIFY(self_sig, static_cast<int32_t>(-1), pto::comm::NotifyOp::AtomicAdd);
  }
}

}  // namespace

extern "C" __aicore__ __attribute__((always_inline)) void kernel_entry(__gm__ int64_t *args) {
  __gm__ Tensor *input_tensor = reinterpret_cast<__gm__ Tensor *>(args[0]);
  __gm__ Tensor *target_tensor = reinterpret_cast<__gm__ Tensor *>(args[1]);
  __gm__ Tensor *signal_tensor = reinterpret_cast<__gm__ Tensor *>(args[2]);
  __gm__ Tensor *send_counts_tensor = reinterpret_cast<__gm__ Tensor *>(args[3]);
  __gm__ Tensor *recv_counts_tensor = reinterpret_cast<__gm__ Tensor *>(args[4]);
  // args[5] = CommContext* on both rails (HOST builtin and CHIP MaterializeDistTensorCtx;
  // extra ctx pointers at args[6..] are unread duplicates). nranks from rankNum —
  // no separate rank-count scalar — keeps one kernel source for both rails.
  __gm__ CommContext *comm_ctx = reinterpret_cast<__gm__ CommContext *>(args[5]);
  int nranks = static_cast<int>(comm_ctx->rankNum);
  int32_t block_idx = get_block_idx(args);
  int32_t block_num = get_block_num(args);

  // Early returns below must agree on every rank: asymmetric return leaves peers
  // blocked in ExchangeBarrier (hang, not corruption).
  if (nranks <= 0 || nranks > kMaxSupportedRanks || block_num <= 0 || block_idx < 0 || block_idx >= block_num) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  int my_rank = static_cast<int>(comm_ctx->rankId);

  // Block-aware barrier (RFC #2521 K2): signal is [NR, S] with any S >= 1,
  // barrier-only — counts publish on recv_counts (Phase 2 below), never on
  // signal, so the full stride is available for per-block lanes, no column
  // is reserved. `active_blocks` caps at signal_stride so a block never
  // races into a lane it does not own; a block whose `block_idx` is not
  // covered returns immediately rather than calling ExchangeBarrier.
  int64_t signal_stride = signal_tensor->ndims == 1 ? 1 : static_cast<int64_t>(signal_tensor->shapes[1]);
  if (signal_stride < 1) {
    pipe_barrier(PIPE_ALL);
    return;
  }
  int32_t active_blocks =
      block_num < static_cast<int32_t>(signal_stride) ? block_num : static_cast<int32_t>(signal_stride);
  if (block_idx >= active_blocks) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // target is [NR * MAX_RECV, SIZE]; derive MAX_RECV from runtime nranks so an
  // over-provisioned signal cannot silently change the per-dest block size.
  int64_t max_recv = static_cast<int64_t>(target_tensor->shapes[0]) / nranks;
  if (max_recv <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  int64_t row_numel = 1;
  for (uint32_t dim = 1; dim < target_tensor->ndims; ++dim) {
    row_numel *= static_cast<int64_t>(target_tensor->shapes[dim]);
  }
  if (row_numel <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // Distinct windows (same race rationale as symmetric all_to_all).
  __gm__ {{dtype_cpp}} *input_local =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(input_tensor->buffer.addr) + input_tensor->start_offset;
  __gm__ {{dtype_cpp}} *target =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(target_tensor->buffer.addr) + target_tensor->start_offset;
  __gm__ int32_t *signal_base =
      reinterpret_cast<__gm__ int32_t *>(signal_tensor->buffer.addr) + signal_tensor->start_offset;
  __gm__ int32_t *send_counts_base =
      reinterpret_cast<__gm__ int32_t *>(send_counts_tensor->buffer.addr) + send_counts_tensor->start_offset;
  __gm__ int32_t *recv_counts_base =
      reinterpret_cast<__gm__ int32_t *>(recv_counts_tensor->buffer.addr) + recv_counts_tensor->start_offset;

  using ShapeDyn = pto::Shape<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using StrideDyn = pto::Stride<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using Global = pto::GlobalTensor<{{dtype_cpp}}, ShapeDyn, StrideDyn, pto::Layout::ND>;
  using TileData = pto::Tile<pto::TileType::Vec, {{dtype_cpp}}, 1, kTileCount, pto::BLayout::RowMajor, -1, -1>;

  // Staging tile width is kTileCount; TPUT_IMPL chunks larger payloads against GetValidCol().
  // TASSIGN(0x0) is dtype-agnostic (0x10000 was FP32-only).
  TileData send_tile(1, kTileCount);
  TASSIGN(send_tile, 0x0);

  // Start-of-call global sync: under persistent execution with
  // reset_persistent_windows=False, this call's TPUTs below must not begin
  // until every rank has actually reached this call — otherwise this rank's
  // round-N+1 write can race a peer still finishing round N. Each active
  // block rendezvous-blocks independently on its own signal lane
  // (signal_base + peer*signal_stride + block_idx), so this remains correct
  // whether block_num is 1 or many — no per-block ordering (e.g. block 0
  // leading the rest) is required for this barrier's own correctness.
  ExchangeBarrier(comm_ctx, signal_base, my_rank, nranks, signal_stride, block_idx);

  int32_t self_rows = 0;

  // Phase 1: for each dest (including self, HCCL/InCore EmitFor parity):
  //   rows = clamp(send_counts[dest], 0, max_recv)  // same as LowerTensorAllToAllVRule
  //   TPUT exactly `rows` rows (not full max_recv). Capacity tail past `rows` is untouched
  //     and may be NaN/Inf on reuse — consumers must trim to recv_counts before reducing.
  // Counts are NOT published here: a remote Set into recv_counts is not proven visible by
  // a later barrier AtomicAdd on signal. Phase 2 publishes on recv_counts itself.
  for (int dest = 0; dest < nranks; ++dest) {
    int32_t raw_count = send_counts_base[dest];
    int64_t rows64 = static_cast<int64_t>(raw_count);
    if (rows64 > max_recv) rows64 = max_recv;
    if (rows64 < 0) rows64 = 0;
    int32_t rows = static_cast<int32_t>(rows64);

    if (dest == my_rank) {
      self_rows = rows;
    }

    int64_t src_row_offset = static_cast<int64_t>(dest) * max_recv * row_numel;
    int64_t dst_row_offset = static_cast<int64_t>(my_rank) * max_recv * row_numel;
    __gm__ {{dtype_cpp}} *remote_block = CommRemotePtr(comm_ctx, target + dst_row_offset, dest);

    // Flat [rows * SIZE] transfer; TPUT_IMPL re-chunks above kTileCount. rows==0 skips.
    int64_t block_numel = rows64 * row_numel;
    if (block_numel > 0) {
      // Reset ColMaskInternal every dest: (1) TputProcessSlice mutates it for ragged
      // tails and never restores; reuse would shrink later dests. (2) Cap to block_numel
      // or short payloads DMA the full kTileCount width.
      send_tile.ColMaskInternal =
          static_cast<int>(block_numel <= kTileCount ? block_numel : kTileCount);
      ShapeDyn shape(1, 1, 1, 1, block_numel);
      StrideDyn stride(block_numel, block_numel, block_numel, block_numel, 1);
      Global src_g(input_local + src_row_offset, shape, stride);
      Global dst_g(remote_block, shape, stride);

      pto::comm::TPUT(dst_g, src_g, send_tile);
    }
  }

  // ==================================================================
  // Phase 2: authoritative recv_counts publish on the recv_counts window
  // (never signal — signal is barrier-only, see above). block_idx==0's job
  // only: recv_counts is a single (not per-block) output, every block
  // computes the identical `rows` per dest (Phase 1's dest loop reads only
  // send_counts_base, independent of block_idx), so one designated block
  // filling it exactly once avoids multiple blocks' AtomicAdd(rows+1) piling
  // onto the same cell (which would corrupt the encoded value, not just
  // duplicate work). Blocks != 0 have nothing left to synchronize here: their
  // own start-of-call ExchangeBarrier (own lane) and Phase 1 TPUTs are
  // already locally fenced; the orchestrator task-join gates any consumer on
  // ALL blocks completing, not on anything this kernel signals itself.
  //
  // Never CommRemotePtr(send_counts). Ready-only Wake + GM load of a prior Set
  // still saw 0 on P=4 (Wait ≠ visibility of a different address). Carry
  // count on the same AtomicAdd/TWAIT cell: Set(0) clears the previous call's
  // rows, AtomicAdd(rows+1) wakes Wait(GE 1) even when rows==0. NotifyOp::Set
  // (rows+1) alone timed out on a2a3.
  // ==================================================================
  PublishFence();
  if (block_idx == 0) {
    for (int dest = 0; dest < nranks; ++dest) {
      if (dest == my_rank) continue;
      int32_t raw_count = send_counts_base[dest];
      int64_t rows64 = static_cast<int64_t>(raw_count);
      if (rows64 > max_recv) rows64 = max_recv;
      if (rows64 < 0) rows64 = 0;
      int32_t encoded = static_cast<int32_t>(rows64) + 1;
      __gm__ int32_t *remote_slot = CommRemotePtr(comm_ctx, recv_counts_base + my_rank, dest);
      pto::comm::Signal count_sig(remote_slot);
      pto::comm::TNOTIFY(count_sig, static_cast<int32_t>(0), pto::comm::NotifyOp::Set);
      pto::comm::TNOTIFY(count_sig, encoded, pto::comm::NotifyOp::AtomicAdd);
    }
    PublishFence();
    ExchangeBarrier(comm_ctx, signal_base, my_rank, nranks, signal_stride, block_idx);
    // Local fill: self from self_rows; peers Wait/load then AtomicAdd(-1) leaving rows.
    for (int src = 0; src < nranks; ++src) {
      int32_t rows;
      if (src == my_rank) {
        rows = self_rows;
        recv_counts_base[src] = rows;
        pto::comm::Signal count_sig(recv_counts_base + src);
        pto::comm::TNOTIFY(count_sig, rows, pto::comm::NotifyOp::Set);
      } else {
        __gm__ int32_t *count_slot = recv_counts_base + src;
        pto::comm::Signal count_lane(count_slot);
        pto::comm::TWAIT(count_lane, static_cast<int32_t>(1), pto::comm::WaitCmp::GE);
        dcci((__gm__ void *)count_slot, cache_line_t::SINGLE_CACHE_LINE);
        // Keep the load after dcci.
        asm volatile("" ::: "memory");
        int32_t encoded = *count_slot;
        // Leave `rows` (= encoded - 1) in the cell for post-collective consumers.
        pto::comm::TNOTIFY(count_lane, static_cast<int32_t>(-1), pto::comm::NotifyOp::AtomicAdd);
        int64_t rows64 = static_cast<int64_t>(encoded) - 1;
        if (rows64 > max_recv) rows64 = max_recv;
        if (rows64 < 0) rows64 = 0;
        rows = static_cast<int32_t>(rows64);
        // Store matches the post-AtomicAdd cell; Set reinforces notify visibility.
        recv_counts_base[src] = rows;
        pto::comm::TNOTIFY(count_lane, rows, pto::comm::NotifyOp::Set);
      }
    }
  }
  PublishFence();
}
