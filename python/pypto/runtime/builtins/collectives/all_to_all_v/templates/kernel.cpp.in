// Generated from {{template_package}}.

#include <cstdint>
#include <pto/pto-inst.hpp>

#include "platform_comm/comm_context.h"
#include "pto/comm/comm_types.hpp"
#include "pto/comm/pto_comm_inst.hpp"
#include "tensor.h"

#ifndef __gm__
#define __gm__
#endif

#ifndef __aicore__
#define __aicore__ [aicore]
#endif

namespace {

static constexpr int64_t kTileCount = 256;
static constexpr int64_t kMaxRecv = {{max_recv}};
static constexpr int kMaxSupportedRanks = 16;

template <typename T>
AICORE inline __gm__ T *CommRemotePtr(__gm__ CommContext *ctx, __gm__ T *local_ptr, int pe) {
  uint64_t local_base = ctx->windowsIn[ctx->rankId];
  uint64_t offset = reinterpret_cast<uint64_t>(local_ptr) - local_base;
  return reinterpret_cast<__gm__ T *>(ctx->windowsIn[pe] + offset);
}

}  // namespace

extern "C" __aicore__ __attribute__((always_inline)) void kernel_entry(__gm__ int64_t *args) {
  __gm__ Tensor *input_tensor = reinterpret_cast<__gm__ Tensor *>(args[0]);
  __gm__ Tensor *target_tensor = reinterpret_cast<__gm__ Tensor *>(args[1]);
  __gm__ Tensor *signal_tensor = reinterpret_cast<__gm__ Tensor *>(args[2]);
  int nranks = static_cast<int>(args[3]);
  __gm__ CommContext *comm_ctx = reinterpret_cast<__gm__ CommContext *>(args[4]);

  if (nranks <= 0 || nranks > kMaxSupportedRanks) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  int my_rank = static_cast<int>(comm_ctx->rankId);

  int64_t row_numel = 1;
  for (uint32_t dim = 1; dim < target_tensor->ndims; ++dim) {
    row_numel *= static_cast<int64_t>(target_tensor->shapes[dim]);
  }
  if (row_numel <= 0) {
    pipe_barrier(PIPE_ALL);
    return;
  }

  // `input` and `target` are two DISTINCT windows. `input` is read-only here
  // (this rank's own outgoing staging, populated by an earlier stage_step)
  // and is NEVER the destination of any incoming TPUT. `target` is
  // write-only here (every incoming push lands in it) plus the final result
  // read back by the caller.
  //
  // Both are flat 2D [NR * kMaxRecv, SIZE]. Per-destination send counts are
  // read at runtime from signal[dest]: the inner loop pushes exactly
  // signal[dest] rows to peer dest (must be ≤ kMaxRecv).
  __gm__ {{dtype_cpp}} *input_local =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(input_tensor->buffer.addr) + input_tensor->start_offset;
  __gm__ {{dtype_cpp}} *target =
      reinterpret_cast<__gm__ {{dtype_cpp}} *>(target_tensor->buffer.addr) + target_tensor->start_offset;
  __gm__ int32_t *signal_base =
      reinterpret_cast<__gm__ int32_t *>(signal_tensor->buffer.addr) + signal_tensor->start_offset;

  using ShapeDyn = pto::Shape<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using StrideDyn = pto::Stride<pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC, pto::DYNAMIC>;
  using Global = pto::GlobalTensor<{{dtype_cpp}}, ShapeDyn, StrideDyn, pto::Layout::ND>;
  using TileData = pto::Tile<pto::TileType::Vec, {{dtype_cpp}}, 1, kTileCount, pto::BLayout::RowMajor, -1, -1>;

  int tile_cols = static_cast<int>(row_numel < kTileCount ? row_numel : kTileCount);
  TileData send_tile(1, tile_cols);
  TASSIGN(send_tile, 0x10000);

  // self_row_offset: base of this rank's receive slot in the flat target.
  // Each rank reserves kMaxRecv rows in the target window.
  int64_t self_row_offset = static_cast<int64_t>(my_rank) * kMaxRecv * row_numel;

  // ==================================================================
  // Phase 1: push — variable-size per-destination push via TPUT.
  // For each peer dest, read signal[dest] (runtime send count) and push
  // exactly that many rows from input[dest*kMaxRecv + r, :] into the peer's
  // target[my_rank*kMaxRecv + r, :].  Include self (HCCL identity).
  // ==================================================================
  for (int dest = 0; dest < nranks; ++dest) {
    int send_rows = signal_base[dest];
    // Defensive CHECK: per-dest send count must not exceed MAX_RECV.
    // The deducer guarantees NR*MAX_RECV is compile-time static, and the
    // runtime signal values are expected to stay within the capacity bound.
    if (send_rows < 0 || send_rows > static_cast<int>(kMaxRecv)) {
      pipe_barrier(PIPE_ALL);
      return;
    }

    for (int r = 0; r < send_rows; ++r) {
      int64_t src_row_off = (static_cast<int64_t>(dest) * kMaxRecv + r) * row_numel;
      int64_t dst_row_off = self_row_offset + static_cast<int64_t>(r) * row_numel;
      __gm__ {{dtype_cpp}} *remote_row = CommRemotePtr(comm_ctx, target + dst_row_off, dest);

      for (int64_t base = 0; base < row_numel; base += tile_cols) {
        int64_t chunk64 = row_numel - base;
        if (chunk64 > tile_cols) chunk64 = tile_cols;
        int chunk = static_cast<int>(chunk64);
        send_tile.ColMaskInternal = chunk;

        ShapeDyn shape(1, 1, 1, 1, chunk);
        StrideDyn stride(chunk, chunk, chunk, chunk, 1);
        Global src_g(input_local + src_row_off + base, shape, stride);
        Global dst_g(remote_row + base, shape, stride);

        pipe_barrier(PIPE_ALL);
        pto::comm::TPUT(dst_g, src_g, send_tile);
        pipe_barrier(PIPE_ALL);
      }
    }
  }

  // ==================================================================
  // Phase 2: barrier — notify peers and wait for all (NotifyOp::Set).
  // ==================================================================
  pipe_barrier(PIPE_ALL);
  dsb(DSB_DDR);
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    __gm__ int32_t *remote_signal = CommRemotePtr(comm_ctx, signal_base + my_rank, peer);
    pto::comm::Signal sig(remote_signal);
    pto::comm::TNOTIFY(sig, static_cast<int32_t>(1), pto::comm::NotifyOp::Set);
  }
  for (int peer = 0; peer < nranks; ++peer) {
    if (peer == my_rank) continue;
    pto::comm::Signal sig(signal_base + peer);
    pto::comm::TWAIT(sig, static_cast<int32_t>(1), pto::comm::WaitCmp::GE);
  }

  pipe_barrier(PIPE_ALL);
}
