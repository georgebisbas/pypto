// Generated from {{template_package}}.

#include <cstdint>

#include "orchestration_api.h"

namespace {

// The maximum admitted AIV block count B for a requested launch-width limit L
// across P participating ranks (RFC #2521 K2 frozen contract item 3). This
// entry.cpp.in template is compiled standalone, with no link-time path back
// into the compiler's own C++ sources, so it cannot call
// python/pypto/ir/op/distributed/launch_width.py's cal_all_to_all_v_blocks —
// this is an independent mirror of that same formula.
int32_t CalAllToAllVBlocks(int32_t p, int32_t l) { return l < p ? l : (l / p) * p; }

template <typename DType>
void submit_all_to_all_v_kernel(const ChipTaskArgs &orch_args) {
  const Tensor &input = orch_args.tensor(0).ref();
  const Tensor &target = orch_args.tensor(1).ref();
  const Tensor &signal = orch_args.tensor(2).ref();
  const Tensor &send_counts = orch_args.tensor(3).ref();
  const Tensor &recv_counts = orch_args.tensor(4).ref();

  // nranks (P) and core_num (L) reach only this dispatch's own args, never the
  // synthesized AICore kernel's `CoreTaskArgs` below — the kernel itself still
  // derives nranks from CommContext::rankNum, so its argument layout stays
  // identical to the managed CHIP/L2 rail's, which renders the same kernel
  // template.
  const int32_t nranks = static_cast<int32_t>(orch_args.scalar(0));
  const int32_t core_num = static_cast<int32_t>(orch_args.scalar(2));
  if (nranks <= 0) {
    rt_report_fatal(SIMPLER_ERROR_INVALID_ARGS, "all_to_all_v: nranks must be positive, got %d", nranks);
    return;
  }
  if (core_num <= 0) {
    rt_report_fatal(SIMPLER_ERROR_INVALID_ARGS, "all_to_all_v: core_num must be positive, got %d", core_num);
    return;
  }
  const int32_t admitted_blocks = CalAllToAllVBlocks(nranks, core_num);

  // signal is 2D [NR, S] (collective.cpp's deducer enforces a positive
  // compile-time S) or 1D [NR] (S == 1, all_to_all_v's own composite deducer
  // only ever emits the 2D form, but this mirrors CheckStaticSignalCapacity's
  // rank-1 acceptance for defense in depth).
  const int64_t signal_stride = signal.ndims == 1 ? 1 : static_cast<int64_t>(signal.shapes[1]);
  if (signal_stride < admitted_blocks) {
    rt_report_fatal(
        SIMPLER_ERROR_INVALID_ARGS,
        "all_to_all_v: signal stride (%lld) is smaller than the admitted block count (%d) for "
        "core_num=%d, nranks=%d",
        static_cast<long long>(signal_stride), admitted_blocks, core_num, nranks
    );
    return;
  }

  CoreTaskArgs params;
  params.add_input(input);
  params.add_inout(target);
  params.add_inout(signal);
  params.add_input(send_counts);
  params.add_inout(recv_counts);
  params.add_scalar(orch_args.scalar(1));  // CommContext device pointer
  params.launch_spec.{{launch_core_count_method}}(admitted_blocks);
  params.launch_spec.set_require_sync_start(true);
  rt_submit_aiv_task(0, params);
}

}  // namespace

extern "C" {

__attribute__((visibility("default"))) OrchestrationConfig aicpu_orchestration_config(
    const ChipTaskArgs &orch_args) {
  (void)orch_args;
  return OrchestrationConfig{
      // 5 window tensors + 1 per-rank ordering token + rank-count scalar +
      // CommContext scalar + core_num scalar.
      .expected_arg_count = 9,
  };
}

__attribute__((visibility("default"))) void aicpu_orchestration_entry(const ChipTaskArgs &orch_args) {
  submit_all_to_all_v_kernel<{{dtype_cpp}}>(orch_args);
}

__attribute__((visibility("default"))) void {{entry}}(const ChipTaskArgs &orch_args) {
  aicpu_orchestration_entry(orch_args);
}

}  // extern "C"
